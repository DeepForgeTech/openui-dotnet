<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Distro-packaged ASP.NET Core (e.g. Arch's aspnet-runtime) ships without the targeting pack's
         prune package data, so restore fails with NETSDK1226. This is the SDK's opt-out; it does
         nothing where the data is present. -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The conformance suite's component library, copied next to the test assembly. -->
    <Content Include="..\fixtures\1.0\library.json"
             Link="library.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The sample's real spec, and the prompt upstream's generator made from it. -->
    <Content Include="..\..\samples\react-chat\src\generated\spec.json;..\..\samples\react-chat\src\generated\prompt.txt"
             Link="generated\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenUI.Lang.AspNetCore\OpenUI.Lang.AspNetCore.csproj" />
  </ItemGroup>

</Project>
