<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenUI.Lang</RootNamespace>
    <PackageId>OpenUI.Lang.Core</PackageId>
    <Description>OpenUI Lang for .NET: parser, streaming, evaluation, edit merge and system prompt generation.</Description>
    <PackageTags>openui;openui-lang;generative-ui;llm;streaming;parser</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUI.Lang.Core.Tests" />
  </ItemGroup>

  <!-- The analyzers ship inside this package, so every project that uses Core runs them. -->
  <ItemGroup>
    <ProjectReference Include="..\OpenUI.Lang.Core.Analyzers\OpenUI.Lang.Core.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\OpenUI.Lang.Core.Analyzers\bin\$(Configuration)\netstandard2.0\OpenUI.Lang.Core.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
