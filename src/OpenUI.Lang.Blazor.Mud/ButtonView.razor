<MudButton Variant="@Variant"
           Color="@(Text("type") == "destructive" ? Color.Error : Color.Primary)"
           Size="@Size"
           Disabled="IsRunning"
           OnClick="@(() => RunOnceAsync(() => RunAsync("action", Text("label"))))">@Text("label")</MudButton>

@code {
    private Variant Variant => Text("variant") switch
    {
        "secondary" => Variant.Outlined,
        "tertiary" => Variant.Text,
        _ => Variant.Filled,
    };

    private Size Size => Text("size") switch
    {
        "extra-small" or "small" => Size.Small,
        "large" => Size.Large,
        _ => Size.Medium,
    };
}
