@inherits Microsoft.AspNetCore.Components.ComponentBase

@* A card's content over an image that fills it. The image is an element, never a CSS url(), so no address can break out of a style. *@
<div style="@($"position:relative;display:flex;flex-direction:column;height:100%;min-height:{MinHeight};overflow:hidden;{Style}")">
    @if (DisplayValues.ImageSource(Src) is { } source)
    {
        <img src="@source" alt="@Alt" loading="lazy" referrerpolicy="no-referrer"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
    }
    else if (Alt.Length > 0)
    {
        <MudText Typo="Typo.caption" Style="@MudStyles.Muted" Class="px-3 pt-2">@Alt</MudText>
    }
    <div style="position:relative;display:flex;flex:1;flex-direction:column;justify-content:space-between">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The panel text sits on over an image, so it reads on any picture.</summary>
    public const string Panel = "background:color-mix(in srgb,var(--mud-palette-surface) 88%,transparent)";

    [Parameter]
    public string? Src { get; set; }

    [Parameter]
    public string Alt { get; set; } = "";

    [Parameter]
    public string MinHeight { get; set; } = "0";

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public Microsoft.AspNetCore.Components.RenderFragment? ChildContent { get; set; }
}
