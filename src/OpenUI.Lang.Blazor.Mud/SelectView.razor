<MudSelect T="string"
           Placeholder="@Text("placeholder")"
           Value="@ChosenKey()"
           ValueChanged="Choose"
           ToStringFunc="ChoiceLabel"
           Error="@(FieldError() is not null)"
           ErrorText="@FieldError()"
           Variant="Variant.Outlined"
           Margin="@(Text("size") == "large" ? Margin.Normal : Margin.Dense)"
           aria-label="@Text("name")">
    @foreach (var choice in Choices())
    {
        <MudSelectItem T="string" Value="@choice.Key">@choice.Label</MudSelectItem>
    }
</MudSelect>
