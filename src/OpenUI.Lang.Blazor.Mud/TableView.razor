@inherits GridView

<MudSimpleTable Dense="true" Hover="true" Outlined="true" Elevation="0">
    <thead>
        <tr>
            @foreach (var column in _columns.Take(_grid.Columns))
            {
                <th>@column.Text("label")</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (_grid.TotalRows == 0)
        {
            <tr><td colspan="@_columns.Count">No rows.</td></tr>
        }
        @for (var row = 0; row < _grid.Rows; row++)
        {
            var index = row;
            <tr>
                @foreach (var column in _columns.Take(_grid.Columns))
                {
                    <td><OpenUIValue Value="@column.Items("data").ElementAtOrDefault(index)" /></td>
                }
            </tr>
        }
    </tbody>
</MudSimpleTable>
@if (_grid.IsCut)
{
    <MudText Typo="Typo.caption">@_grid.Note()</MudText>
}

@code {
    private IReadOnlyList<OuiComponent> _columns = [];
    private DrawnGrid _grid;

    // Here and not while drawing, so views take their cells in the order they come on the page.
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _columns = ItemComponents("columns");
        _grid = FitGrid(_columns.Select(column => column.Items("data").Count).DefaultIfEmpty().Max(), _columns.Count);
    }
}
