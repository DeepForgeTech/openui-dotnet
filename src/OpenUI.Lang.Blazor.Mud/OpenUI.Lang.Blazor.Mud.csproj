<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>OpenUI.Lang.Blazor.Mud</RootNamespace>
    <PackageId>OpenUI.Lang.Blazor.Mud</PackageId>
    <Description>Definitions and MudBlazor views for OpenUI Lang components. Register MudComponents as a component source for OpenUI.Lang.Blazor.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Distro-packaged ASP.NET Core (e.g. Arch's aspnet-runtime) ships without the targeting pack's
         prune package data, so restore fails with NETSDK1226. This is the SDK's opt-out; it does
         nothing where the data is present. -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenUI.Lang.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <ProjectReference Include="..\OpenUI.Lang.Blazor\OpenUI.Lang.Blazor.csproj" />
    <EmbeddedResource Include="spec.json" LogicalName="OpenUI.Lang.Blazor.Mud.spec.json" />
  </ItemGroup>

</Project>
