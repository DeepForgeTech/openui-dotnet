@{ var items = ItemComponents("items"); }
<MudStack Spacing="@(Text("size") == "small" ? 1 : 2)">
    @for (var index = 0; index < items.Count; index++)
    {
        var item = items[index];
        var number = index + 1;
        @if (item["action"].Value.TryGetAction(out _))
        {
            <div role="button" tabindex="0" style="cursor:pointer"
                 @onclick="() => RunOnceAsync(() => RunItemAsync(item))" @onkeydown="key => RunOnKeyAsync(key, () => RunItemAsync(item))">@Row(item, number, true)</div>
        }
        else
        {
            <div>@Row(item, number, false)</div>
        }
    }
</MudStack>

@code {
    private RenderFragment Row(OuiComponent item, int number, bool clickable) =>
        @<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="pa-2">
            @if (Text("variant") == "image")
            {
                @if (item["image"].Value.TryGetObject(out var image))
                {
                    <div style="width:40px;height:40px;flex:none;overflow:hidden;border-radius:var(--mud-default-borderradius)">
                        <ImageOrAlt Src="@image.Text("src")" Alt="@image.Text("alt")" Style="display:block;width:100%;height:100%;object-fit:cover" />
                    </div>
                }
            }
            else
            {
                <MudAvatar Size="Size.Small">@number</MudAvatar>
            }
            <div style="flex:1;min-width:0">
                <MudText Typo="Typo.body1">@item.Text("title")</MudText>
                @if (item.Text("subtitle").Length > 0)
                {
                    <MudText Typo="Typo.caption" Style="@MudStyles.Muted">@item.Text("subtitle")</MudText>
                }
            </div>
            @if (clickable)
            {
                <MudText Typo="Typo.body2" Color="Color.Primary">@item.Text("actionLabel")</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            }
        </MudStack>;

    private Task RunItemAsync(OuiComponent item) => Context.RunActionAsync(item, item["action"], FormName);
}
