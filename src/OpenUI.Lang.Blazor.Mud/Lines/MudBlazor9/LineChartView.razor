@namespace OpenUI.Lang.Blazor.Mud
<MudChart T="double"
          ChartType="ChartType.Line"
          ChartLabels="_labels"
          ChartSeries="_series"
          ChartOptions="_options"
          Width="100%"
          Height="@MudCharts.Height(Number("height"))" />

@code {
    private string[] _labels = [];
    private List<ChartSeries<double>> _series = [];
    private LineChartOptions _options = new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _labels = ChartValues.Labels(Items("labels"));
        _series = MudCharts.Series(ItemComponents("series"));
        _options = new LineChartOptions
        {
            ChartPalette = MudCharts.Colours,
            YAxisTicks = MudCharts.YStep(_series),
            XAxisTitle = Text("xLabel"),
            YAxisTitle = Text("yLabel"),
            InterpolationOption = Text("variant") == "natural" ? InterpolationOption.NaturalSpline : InterpolationOption.Straight,
        };
    }
}
