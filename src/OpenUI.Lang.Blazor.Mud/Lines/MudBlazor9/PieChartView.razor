@namespace OpenUI.Lang.Blazor.Mud
@if (_series.Count == 0)
{
    <MudText Typo="Typo.caption">No data.</MudText>
}
else
{
    <MudChart T="double"
              ChartType="@(Text("variant") == "donut" ? ChartType.Donut : ChartType.Pie)"
              ChartLabels="_labels"
              ChartSeries="_series"
              ChartOptions="Options"
              Width="100%"
              Height="300px" />
}

@code {
    private string[] _labels = [];
    private List<ChartSeries<double>> _series = [];

    // Mud refuses to draw a chart given another type's options.
    private MudBlazor.Charts.IChartOptions Options => Text("variant") == "donut"
        ? new DonutChartOptions { ChartPalette = MudCharts.Colours }
        : new PieChartOptions { ChartPalette = MudCharts.Colours };

    // Mud draws a pie from one series, a slice to a label. It has no half circle, so "semiCircular" draws whole.
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _labels = ChartValues.Labels(Items("labels"));
        var values = ChartValues.Magnitudes(Items("values"), _labels.Length);
        _series = ChartValues.Total(values) > 0
            ? [new ChartSeries<double> { Name = "", Data = values }]
            : [];
    }
}
