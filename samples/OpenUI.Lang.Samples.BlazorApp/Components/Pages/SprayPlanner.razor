@page "/planner"
@inject WeatherTools Tools

<PageTitle>Spray planner</PageTitle>

<div class="page">
    <PageHeader Title="Spray planner" Subtitle="Plan field work around the week's forecast. This page is one program, reading and writing over real HTTP." />
    <OpenUIProgram Program="@Program" Tools="Tools" OnErrors="errors => _errors = errors" />
    <ToolLog Errors="_errors" Program="@Program" />
</div>

@code {
    private static readonly string Program = ProgramFiles.Read("spray-planner.oui");

    private OpenUIErrorList _errors = OpenUIErrorList.Empty;
}
