@page "/"
@page "/chat/{Id:guid}"
@using OpenUI.Lang.Samples.Llm
@inject LlmSettings Llm
@inject IOpenUIConversationStore Store
@inject WeatherTools Tools
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

<div class="chat-page">
    <header class="chat-header">
        <MudText Typo="Typo.h6" HtmlTag="h1" Class="chat-title">@Title</MudText>
    </header>
    <OpenUIChat ConversationId="Id" ConversationIdChanged="KeepAddress" Tools="Tools" OnOpenUrl="OpenUrlAsync">
        <EmptyContent>
            <div class="chat-empty">
                <MudText Typo="Typo.h4" HtmlTag="h2">What should we plan?</MudText>
                <MudText Typo="Typo.body1" Class="page-subtitle">Ask about the weather or a spray job. A reply here is a small program, drawn with MudBlazor components as it arrives.</MudText>
                <div class="chat-starters">
                    @foreach (var starter in Starters)
                    {
                        <button type="button" class="chat-starter" @onclick="() => context.SendAsync(starter.Text)">
                            <MudIcon Icon="@starter.Icon" Size="Size.Small" />
                            <span>
                                <span class="chat-starter-text">@starter.Text</span>
                                <span class="chat-starter-note">@starter.Note</span>
                            </span>
                        </button>
                    }
                </div>
            </div>
        </EmptyContent>
        <PendingContent>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
        </PendingContent>
        <FailureContent>
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@context</MudAlert>
        </FailureContent>
        <Composer>
            <OpenUIChatComposer Session="context" Placeholder="@(Llm.IsFake ? LlmSettings.FakePlaceholder : "Ask for something")" />
            @if (Llm.IsFake)
            {
                <div class="chat-fake">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                    <span>@LlmSettings.FakeNotice</span>
                </div>
            }
        </Composer>
    </OpenUIChat>
</div>

@code {
    private static readonly (string Text, string Note, string Icon)[] Starters =
    [
        ("Can we spray corn today?", "A verdict from the wind and rain", Icons.Material.Outlined.Agriculture),
        ("Show me the forecast", "A chart and a table for the week", Icons.Material.Outlined.Air),
        ("Plan a spray job", "A form with validation rules", Icons.Material.Outlined.EventNote),
    ];

    private string? _title;

    /// <summary>The conversation in the address, or null on the page for a new one.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string Title => _title ?? "New chat";

    protected override async Task OnParametersSetAsync() =>
        _title = Id is { } id ? (await Store.FindAsync(id))?.Title : null;

    // The address now names the conversation, so a reload finds it. The chat stays, and so does the reply.
    private void KeepAddress(Guid? id)
    {
        if (id is { } started)
        {
            Navigation.NavigateTo($"/chat/{started}", replace: true);
        }
    }

    // A link opens once the person agrees.
    private async Task OpenUrlAsync(string url)
    {
        if (await Dialogs.ConfirmAsync("Open this link?", url, "Open"))
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener");
        }
    }
}
