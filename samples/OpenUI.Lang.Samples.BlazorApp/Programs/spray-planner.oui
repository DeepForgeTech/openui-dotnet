$location = "north-field"
$product = "Fungicide"
$date = ""
root = Stack([outlook, forecastCard, work], "column", "l")
locations = Query("listLocations", {}, {locations: []})
forecast = Query("getForecast", {location: $location, days: 7}, {days: []}, 60)
jobs = Query("listSprayJobs", {}, {jobs: []}, 20)
schedule = Mutation("scheduleSprayJob", {location: $location, product: $product, date: $date})
outlook = SprayOutlook(forecast.days, @Count(jobs.jobs))
forecastCard = Card([CardHeader("This week", "Press a day to schedule on it."), forecastStrip])
forecastStrip = @Count(forecast.days) == 0 ? TextContent("Loading the forecast…") : SprayForecast(forecast.days, $date)
work = Stack([scheduler, jobsCard], "row", "l", null, null, true)
scheduler = Card([CardHeader("Schedule a spray job"), picks, outcome])
picks = Form("job", Buttons([submit]), [fieldSelect, productSelect, daySelect])
fieldSelect = FormControl("Field", Select("field", @Each(locations.locations, "l", SelectItem(l.id, l.name)), null, {required: true}, $location))
productSelect = FormControl("Product", Select("product", [SelectItem("Fungicide", "Fungicide"), SelectItem("Herbicide", "Herbicide"), SelectItem("Insecticide", "Insecticide")], null, {required: true}, $product))
daySelect = FormControl("Day", Select("day", @Each(forecast.days, "d", SelectItem(d.date, d.date + ": wind " + d.windMph + " mph, rain " + d.rainChance + "%")), null, {required: true}, $date))
submit = Button("Schedule spray", Action([@Run(schedule), @Run(jobs), @Reset($date)]))
outcome = schedule.status == "error" ? Callout("error", "Could not schedule", schedule.error) : schedule.status == "success" ? Callout("success", "Scheduled", "Scheduled " + schedule.data.id + " on " + schedule.data.date + ".") : null
jobsCard = Card([CardHeader("Spray jobs: " + @Count(jobs.jobs)), jobsTable, refresh])
jobsTable = @Count(jobs.jobs) == 0 ? TextContent("No jobs yet.") : Table([Col("Job", jobs.jobs.id), Col("Field", @Each(jobs.jobs, "j", @First(@Filter(locations.locations, "id", "==", j.location)).name)), Col("Product", jobs.jobs.product), Col("Day", jobs.jobs.date), Col("Status", @Each(jobs.jobs, "j", Tag(j.status, null, "sm", "info")))])
refresh = Buttons([Button("Refresh", @Run(jobs), "secondary")])
