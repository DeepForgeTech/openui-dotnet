root = Card([title, intro, job])
title = TextContent("Plan a spray job", "large-heavy")
intro = TextContent("A form the reply draws. Send it with the fields empty, and the rules stop it.", "small")
job = Form("job", Buttons([send]), [operator, contact, product, acres])
operator = FormControl("Operator", Input("operator", "Who is spraying?", "text", {required: true, minLength: 2}))
contact = FormControl("Email", Input("email", null, "email", {required: true, email: true}))
product = FormControl("Product", Select("product", [SelectItem("Fungicide", "Fungicide"), SelectItem("Herbicide", "Herbicide"), SelectItem("Insecticide", "Insecticide")], null, {required: true}))
acres = FormControl("Acres", Input("acres", null, "number", {required: true, min: 1, max: 640}))
send = Button("Send the plan", @ToAssistant("Here is the plan"))
