root = Stack([iconHeading, icons, textHeading, texts, metricHeading, metrics, tagHeading, tags, entityHeading, entities, listHeading, plainList, imageList], "column", "l")
iconHeading = TextContent("Icon, IconText and IconButton", "large-heavy")
icons = Stack([Icon("sun"), Icon("cloud-rain"), Icon("thermometer"), Icon("no-such-icon"), Icon("no-such-icon", "weather"), IconText(Icon("thermometer"), "danger", "m", "Frost warning", "Low of 28 °F tonight", true), IconText(Icon("droplets"), "info", "m", "Rain", "0.4 in expected", false, "vertical"), IconText(Icon("sprout"), "success", "m", "Emergence", "Stand count 34k"), IconText(Icon("triangle-alert"), "warning", "m", "Wind", "Gusts to 22 mph"), IconText(Icon("lock"), "inverted", "m", "Locked", "Spray window closed"), IconButton("Refresh forecast", Icon("refresh-cw"), @ToAssistant("Refresh the forecast"), "primary", "medium", "circle"), IconButton("Open field map", Icon("map-pin"), @ToAssistant("Open the field map"), "secondary", "small", "square"), IconButton("Bookmark field", Icon("bookmark"), null, "tertiary", "large")], "row", "l", "center", "start", true)
textHeading = TextContent("Text and BoldText", "large-heavy")
texts = Stack([Text("text", "North 40", "Corn, V8"), Text("number", "1,284", "bushels per hour", "number", "lg"), BoldText("text", "Wind 8 mph", "Within the spray window", "text", "md"), BoldText("number", "72 °F", "+4 °F since morning", "metric", "sm"), Text("number", "31 %", "-2 points this week", "metric", "xs")], "row", "xl", "start", "start", true)
metricHeading = TextContent("MetricIndicatorInline and MetricIndicatorWithStrikethrough", "large-heavy")
metrics = Stack([MetricIndicatorInline("$4.62", "per bushel", {direction: "up", value: 3.2}), MetricIndicatorInline("0.61 in", "rain, 7 days", {direction: "down", value: 18}), MetricIndicatorInline("86 %", "stand"), MetricIndicatorWithStrikethrough("$4.62", "December corn", "$4.48", {direction: "up", value: 3.1}), MetricIndicatorWithStrikethrough("$11.90", "November soybeans", "$12.35", {direction: "down", value: 3.6}), MetricIndicatorWithStrikethrough("19 %", "grain moisture")], "row", "xl", "start", "start", true)
tagHeading = TextContent("TagBlock: sm, md, lg", "large-heavy")
tags = Stack([TagBlock(["Corn", "V8", "North 40"]), TagBlock(["Frost watch", "Wind advisory"], "md"), TagBlock(["Scouted", "Sprayed", "Irrigated"], "lg")], "column", "s")
entityHeading = TextContent("EntityList: default with header and footer, then small", "large-heavy")
entities = Stack([EntityList([{left: "North 40", right: "412 ac"}, {left: "South 80", right: "78 ac"}, {left: "East bottom", right: "36.5 ac"}], "default", {left: "Field", right: "Acres", rightVariant: "number"}, {left: "Total", right: "526.5 ac", rightVariant: "number"}), EntityList([{left: "Wind", right: "8 mph", rightVariant: "number"}, {left: "Humidity", right: "54 %", rightVariant: "number"}, {left: "Dew point", right: "51 °F", rightVariant: "number"}], "small")], "row", "l", "start", "start", true)
listHeading = TextContent("ListBlock: numbered, with actions, compact, and with images", "large-heavy")
plainList = Stack([ListBlock([ListItem("Scout North 40", "Check for armyworm"), ListItem("Calibrate sprayer", "Nozzle 3 reads low", null, "Open checklist", @ToAssistant("Open the sprayer checklist")), ListItem("Order fungicide")]), ListBlock([ListItem("Gusts over 20 mph"), ListItem("Rain inside 6 hours"), ListItem("Temperature over 85 °F")], "number", "small")], "row", "l", "start", "start", true)
imageList = ListBlock([ListItem("Probe 3", "31% moisture at 12 in", {src: "images/sensor.svg", alt: "Soil probe 3"}), ListItem("Sprayer 2", "East gate", {src: "images/harvest.svg", alt: "Sprayer 2"}, "Locate", @ToAssistant("Where is sprayer 2?")), ListItem("Probe 5", "27% moisture at 24 in", {src: "not allowed:", alt: "Soil probe 5"})], "image")
