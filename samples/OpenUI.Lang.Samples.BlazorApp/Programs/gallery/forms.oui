$notes = ""
root = Card([title, jobForm, alerts, notesEcho])
title = TextContent("Schedule a spray job", "large-heavy")
heading = Label("Job details")
fieldField = FormControl("Field", Input("field", "North 40"), "As it is named on the map")
tankField = FormControl("Tank mix", Select("tank", [SelectItem("glyphosate", "Glyphosate"), SelectItem("atrazine", "Atrazine"), SelectItem("foliar", "Foliar feed")], "Pick a mix"))
boomField = FormControl("Boom height (in)", Slider("boom", "continuous", 10, 60, 5, [24]))
notesField = FormControl("Notes", TextArea("notes", "Anything the crew should know before they start", 4, {maxLength: 200}, $notes), "Up to 200 characters")
dayField = FormControl("Spray day", DatePicker("day", "single", {required: true}))
windowField = FormControl("Weather window to watch", DatePicker("window", "range"), "Pick the first and last day")
checksField = FormControl("Before you go", CheckBoxGroup("checks", [CheckBoxItem("Wind under 10 mph", "Check the gauge at the field edge", "wind", true), CheckBoxItem("No rain for 6 hours", "Use the hourly forecast", "rain"), CheckBoxItem("Buffer strips marked", "Flags along the creek side", "buffers")], {required: true}))
cropField = FormControl("Crop", RadioGroup("crop", [RadioItem("Corn", "Pre-tassel, 38 days in", "corn"), RadioItem("Soybeans", "Second pass of the season", "soybeans"), RadioItem("Wheat", "Fungicide at flag leaf", "wheat")], "corn", {required: true}))
equipmentField = FormControl("Equipment", Chips("equipment", "multiple", [ChipItem("boom", "Boom sprayer"), ChipItem("drone", "Drone"), ChipItem("nurse", "Nurse truck"), ChipItem("mixer", "Mixing station", null, true)], null, ["boom", "nurse"]), "Pick everything the crew will bring")
shiftField = FormControl("Shift", Chips("shift", "single", [ChipItem("dawn", "Dawn"), ChipItem("midday", "Midday"), ChipItem("dusk", "Dusk")], {required: true}, "dawn"))
methodField = FormControl("Application method", OptionCards("method", "single", [OptionCard("ground", "Ground rig", "Best drift control"), OptionCard("air", "Aerial", "Fastest, needs a calm day"), OptionCard("spot", "Spot treat", "Only the flagged patches", null, true)], {required: true}))
productsField = FormControl("Products", OptionCards("products", "multiple", [OptionCard("herbicide", "Herbicide", "Pre-emergent"), OptionCard("fungicide", "Fungicide", "Protectant"), OptionCard("foliar", "Foliar feed")], null, ["fungicide"]))
actions = Buttons([send, clear])
send = Button("Schedule job", @ToAssistant("Schedule this spray job"))
clear = Button("Clear notes", @Reset($notes), "tertiary")
jobForm = Form("job", actions, [heading, fieldField, tankField, boomField, notesField, dayField, windowField, checksField, cropField, equipmentField, shiftField, methodField, productsField])
alerts = SwitchGroup("alerts", [SwitchItem("Text me", "When the wind picks up", "text", true), SwitchItem("Email me", "A summary after each job", "email")], "card")
notesEcho = TextContent($notes == "" ? "No notes yet." : "Notes so far: " + $notes, "small")
