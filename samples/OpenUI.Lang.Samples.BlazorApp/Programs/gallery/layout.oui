$openSmall = false
$openMedium = false
$openLarge = false
root = Stack([tabsHeader, tabs, divider, accordionHeader, accordion, stepsHeader, steps, carouselHeader, fieldCards, sunkCards, modalHeader, modalButtons, smallModal, mediumModal, largeModal], "column", "l")
divider = Separator()
tabsHeader = InlineHeader("Tabs", "One panel at a time, picked from the tab bar.")
tabs = Tabs([TabItem("forecast", "Forecast", [forecastTable]), TabItem("risk", "Disease risk", [TextCallout("warning", "Leaf wetness above 80% on Wednesday", "Blight pressure is high until the front passes."), CodeBlock("text", "Mon  low\nTue  low\nWed  high\nThu  moderate")]), TabItem("log", "Spray log", [TextContent("Nothing sprayed on **north-field** since 14 Oct.")])])
forecastTable = Table([Col("Day", ["Mon", "Tue", "Wed"]), Col("High °F", [71, 68, 64]), Col("Wind mph", [6, 11, 18]), Col("Spray", [Tag("yes", null, null, "success"), Tag("yes", null, null, "success"), Tag("no", null, null, "neutral")])])
accordionHeader = InlineHeader("Accordion", "One section open at a time; click the open one to close it.")
accordion = Accordion([AccordionItem("window", "When can we spray?", [TextContent("Monday and Tuesday. Wind stays under **10 mph** until Tuesday evening.")]), AccordionItem("products", "Which products?", [MarkDownRenderer("- Fungicide for the blight window\n- Herbicide once the field dries out")]), AccordionItem("limits", "Label limits", [TextCallout("info", "Re-entry interval", "Keep crews out of the field for 12 hours after the fungicide pass.")])])
stepsHeader = InlineHeader("Steps", "A numbered guide. Each step's details are markdown.")
steps = Steps([StepsItem("Check the forecast", "Wind under **10 mph** and no rain for **6 hours**."), StepsItem("Mix the product", "Fill the tank to half, add the fungicide, then top up.\n\nSee the [label](https://example.com/label) for rates."), StepsItem("Spray and log it", "Record the field, product and acres in the spray log.")])
carouselHeader = InlineHeader("Carousel", "One slide at a time with arrows. Card style first, then sunk.")
fieldCards = Carousel([[CardHeader("North field", "42 acres, corn"), TextContent("Sprayable Monday.")], [CardHeader("River bottom", "18 acres, soybeans"), TextContent("Wet until Wednesday.")], [CardHeader("Hill block", "65 acres, wheat"), TextContent("Sprayable Tuesday.")]], "card")
sunkCards = Carousel([[TextContent("Crew A is at the north field.", "small")], [TextContent("Crew B is loading the sprayer.", "small")]], "sunk")
modalHeader = InlineHeader("Modal", "Opened by a button; the X, Escape and the backdrop all close it.")
modalButtons = Buttons([Button("Small", @Set($openSmall, true), "secondary"), Button("Medium", @Set($openMedium, true), "secondary"), Button("Large", @Set($openLarge, true), "secondary")])
smallModal = Modal("Confirm spray", $openSmall, [TextContent("Spray **north-field** on Monday?"), Buttons([Button("Confirm", @Set($openSmall, false)), Button("Cancel", @Set($openSmall, false), "tertiary")])], "sm")
mediumModal = Modal("Spray window", $openMedium, [TextContent("Monday and Tuesday are open. Wednesday's wind rules it out."), forecastTable], "md")
largeModal = Modal("Weekly plan", $openLarge, [CardHeader("Week of 2 Nov", "Three fields, two products"), forecastTable, TextCallout("neutral", "Note", "Dates move if the front arrives early.")], "lg")
