root = Stack([intro, areaCard, trendCard, radarCard, rankCard, shareCard, scatterCard], "column", "l")
intro = TextContent("Season at a glance", "large-heavy")
months = ["Apr", "May", "Jun", "Jul", "Aug", "Sep"]
rain = Series("Rain (in)", [2.1, 3.4, 4.8, 3.9, 2.6, 1.8])
irrigation = Series("Irrigation (in)", [0, 0.5, 1.8, 3.2, 2.9, 0.4])
areaCard = Card([TextContent("Water on the field", "small-heavy"), AreaChart(months, [rain, irrigation], "linear", "Month", "Inches", 260), AreaChart(months, [rain, irrigation], "natural", null, null, 220), AreaChart(months, [rain], "step")])
trendCard = Card([TextContent("Month by month", "small-heavy"), BarChart(months, [rain, irrigation], "grouped", "Month", "Inches", 260), BarChart(months, [rain, irrigation], "stacked", "Month", "Inches", 260), LineChart(months, [rain, irrigation], "linear", "Month", "Inches", 260), LineChart(months, [rain, irrigation], "step", "Month", "Inches", 260)])
radarCard = Card([TextContent("Hybrid comparison", "small-heavy"), RadarChart(["Yield", "Drought", "Standability", "Early vigor", "Test weight"], [Series("DKC 62-70", [8, 6, 7, 9, 7]), Series("P1185", [7, 8, 6, 6, 8])])])
rankCard = Card([TextContent("Acres by crop", "small-heavy"), HorizontalBarChart(["Corn", "Soybeans", "Winter wheat", "Alfalfa", "Sorghum"], [Series("2025", [820, 640, 310, 140, 60]), Series("2026", [900, 580, 340, 120, 90])], "grouped", "Acres", "Crop"), HorizontalBarChart(["North", "South", "East"], [Series("Planted", [410, 520, 380]), Series("Fallow", [90, 40, 120])], "stacked")])
shareCard = Card([TextContent("Where the spray went", "small-heavy"), PieChart(["Herbicide", "Fungicide", "Insecticide", "Foliar"], [46, 28, 14, 12]), PieChart(["Herbicide", "Fungicide", "Insecticide", "Foliar"], [46, 28, 14, 12], "donut"), PieChart(["Ground", "Aerial"], [72, 28], "pie", "semiCircular"), RadialChart(["Corn", "Soybeans", "Wheat", "Alfalfa"], [92, 74, 58, 31]), SingleStackedBarChart(["Planted", "Emerged", "Harvested", "Fallow"], [48, 31, 12, 9])])
scatterCard = Card([TextContent("Rainfall against yield", "small-heavy"), ScatterChart([ScatterSeries("Corn", [Point(18, 162, 40), Point(22, 171, 62), Point(25, 189, 55), Point(29, 204, 80), Point(33, 198, 48)]), ScatterSeries("Soybeans", [Point(17, 48), Point(21, 54), Point(26, 61), Point(30, 58), Point(34, 66)])], "Season rainfall (in)", "Yield (bu/ac)")])
