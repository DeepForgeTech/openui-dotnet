$picked = "Nothing picked yet"
root = Stack([pick, snippetHeading, snippets, overviewHeading, overview, contextHeading, contexts, compositeHeading, composites, visualHeading, visuals], "column", "l")
pick = Callout("info", "Last card clicked", $picked)
snippetHeading = TextContent("SnippetCardBlock (clickable)", "large-heavy")
snippets = SnippetCardBlock([SnippetCardItem("wind", IconText(Icon("wind"), "info", "m", "Wind", "Now"), BoldText("text", "8 mph")), SnippetCardItem("temp", IconText(Icon("thermometer"), "warning", "m", "Temperature", "Now"), BoldText("number", "72 °F", "+4 °F", "metric")), SnippetCardItem("humidity", ImageText("images/sensor.svg", "Probe", "Humidity", "Probe 3"), Text("number", "54 %")), SnippetCardItem("rain", IconText(Icon("droplets"), "success", "m", "Rain, 24 h"), Text("text", "None"))], "grid", true, @Set($picked, "A snippet card"), 8)
overviewHeading = TextContent("OverviewCardBlock: grid, then carousel", "large-heavy")
overview = Stack([OverviewCardBlock([OverviewCardItem("corn", IconText(Icon("wheat"), "success", "m", "Corn"), MetricIndicatorInline("$4.62", "per bushel", {direction: "up", value: 3.2})), OverviewCardItem("soy", IconText(Icon("sprout"), "info", "m", "Soybeans"), MetricIndicatorInline("$11.90", "per bushel", {direction: "down", value: 3.6})), OverviewCardItem("wheat", Text("text", "Wheat"), MetricIndicatorInline("$5.84", "per bushel"))]), OverviewCardBlock([OverviewCardItem("a", ImageText("images/field.svg", "North 40", "North 40", "Corn"), MetricIndicatorInline("412", "acres")), OverviewCardItem("b", ImageText("images/field.svg", "South 80", "South 80", "Wheat"), MetricIndicatorInline("78", "acres")), OverviewCardItem("c", ImageText("images/field.svg", "East bottom", "East bottom", "Soybeans"), MetricIndicatorInline("36.5", "acres")), OverviewCardItem("d", ImageText("images/field.svg", "West pivot", "West pivot", "Alfalfa"), MetricIndicatorInline("130", "acres"))], "carousel", true, @Set($picked, "An overview card"), "16px")], "column", "m")
contextHeading = TextContent("ContextCardBlock: tag title, text title, gray, and a picture", "large-heavy")
contexts = ContextCardBlock([ContextCardItem("frost", Tag("Frost watch", null, "sm", "warning"), "Low of 28 °F after 2 a.m.", "gray"), ContextCardItem("wind", "Wind", "Gusts to 22 mph by noon"), ContextCardItem("storm", "Radar", "Cell 40 minutes out", null, "images/storm.svg", "Storm cell on radar"), ContextCardItem("note", "Note")], "grid", true, @Set($picked, "A context card"))
compositeHeading = TextContent("CompositeCardBlock: header, body, price and button", "large-heavy")
composites = CompositeCardBlock([CompositeCardItem("seed", ImageTextLarge("images/field.svg", "Corn hybrid", "DKC62-70RIB", "112 day relative maturity"), [Text("text", "Strong stalks, good drydown"), TagBlock(["Corn", "112 day"]), EntityList([{left: "Population", right: "34,000"}, {left: "Bag size", right: "80,000 seeds"}])], {price: MetricIndicatorWithStrikethrough("$318", "per bag", "$342", {direction: "down", value: 7}), button: Button("Add to order", @Set($picked, "Add DKC62-70RIB"), "primary", "normal", "small")}), CompositeCardItem("spray", IconText(Icon("spray-can"), "info", "m", "Fungicide pass", "Tank mix for V10"), [BoldText("text", "40 acres per tank"), MetricIndicatorInline("$14.20", "per acre")], {price: BoldText("number", "$568")}), CompositeCardItem("bare")], "grid", true, @Set($picked, "A composite card"))
visualHeading = TextContent("VisualCardBlock: carousel", "large-heavy")
visuals = VisualCardBlock([VisualCardItem(BoldText("text", "North 40", "Corn at V8"), "n40", "images/field.svg", Tag("Scouted", null, "sm", "success"), "North 40 from the gate"), VisualCardItem(BoldText("text", "Storm cell", "40 minutes out"), "storm", "images/storm.svg", Tag("Radar", null, "sm", "warning"), "Storm cell on radar"), VisualCardItem(BoldText("text", "Soil probe 3", "31% moisture"), "probe", "images/sensor.svg", Tag("Sensor", null, "sm", "info"), "Soil probe"), VisualCardItem(BoldText("text", "No picture yet"), "empty")], "carousel", true, @Set($picked, "A visual card"), 12)
