root = Stack([heading, photo, blockHeading, banner, galleryHeading, gallery, rowHeading, rows, bannerHeading, large, blockedHeading, blocked], "column", "l")
heading = TextContent("Image", "large-heavy")
photo = Image("North 40, corn at V8", "images/field.svg")
blockHeading = TextContent("ImageBlock", "large-heavy")
banner = ImageBlock("images/storm.svg", "Cell moving east of the north field")
