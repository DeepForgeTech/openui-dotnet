gallery = ImageGallery([{src: "images/field.svg", alt: "North 40", details: "Corn at V8, scouted Tuesday morning."}, {src: "images/storm.svg", alt: "Storm cell", details: "Radar shows the leading edge 40 minutes out."}, {src: "images/sensor.svg", alt: "Soil probe", details: "Probe 3 at 12 inches, reading 31 percent moisture."}, {src: "images/harvest.svg", alt: "Sprayer", details: "Self-propelled sprayer parked at the east gate."}, {src: "images/field.svg", alt: "South 80", details: "Wheat, headed out."}, {src: "images/sensor.svg", alt: "Soil probe 5", details: "Probe 5 at 24 inches, reading 27 percent moisture."}])
