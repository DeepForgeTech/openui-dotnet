root = Stack([textHeader, textSizes, markdownHeader, markdownClear, markdownCard, markdownSunk, calloutHeader, callouts, textCalloutHeader, textCallouts, codeHeader, code, headersHeader, headers], "column", "l")
textHeader = InlineHeader("TextContent", "Markdown in five sizes.")
textSizes = Stack([TextContent("Small: spray **windows** open at 6 am.", "small"), TextContent("Default: spray *windows* open at 6 am."), TextContent("Large: ~~Friday~~ Monday is the day.", "large"), TextContent("Small heavy: re-entry is 12 hours", "small-heavy"), TextContent("Large heavy: North field\nSecond line of the same block.", "large-heavy")], "column", "s")
markdownHeader = InlineHeader("MarkDownRenderer", "Clear, card and sunk containers.")
markdownClear = MarkDownRenderer("## Spray notes\n\nA short list for the crew:\n\n1. Check **wind** first\n2. Mix the product\n3. Log the pass\n\nLabels are at [the supplier](https://example.com/labels).", "clear")
markdownCard = MarkDownRenderer("| Product | Rate |\n| --- | --- |\n| Fungicide | 12 oz/ac |\n| Herbicide | 1 qt/ac |\n\nRates are per acre.", "card")
markdownSunk = MarkDownRenderer("> Never spray above 10 mph wind.\n\nCheck the wind with `windMph` in the forecast before loading the tank.", "sunk")
calloutHeader = InlineHeader("Callout", "Markdown in the description.")
callouts = Stack([Callout("info", "Forecast updated", "The **6 am** run moved the front back a day."), Callout("success", "Scheduled", "North field is booked for *Monday*."), Callout("warning", "Wind", "Gusts to **18 mph** on Wednesday:\n\n- Hold the herbicide pass\n- Keep the fungicide pass"), Callout("error", "Sprayer offline", "See [the service log](https://example.com/service)."), Callout("neutral", "Note", "Nothing to do until Monday.")], "column", "s")
textCalloutHeader = InlineHeader("TextCallout", "Plain text in five variants.")
textCallouts = Stack([TextCallout("neutral", "Neutral", "A note with no urgency."), TextCallout("info", "Info", "Forecast updated at 6 am."), TextCallout("warning", "Warning", "Gusts to 18 mph on Wednesday."), TextCallout("success", "Success", "North field is booked for Monday."), TextCallout("danger", "Danger", "Do not enter the field for 12 hours.")], "column", "s")
codeHeader = InlineHeader("CodeBlock", "Escaped text with its language.")
code = CodeBlock("json", "{\n  \"field\": \"north-field\",\n  \"product\": \"Fungicide\",\n  \"note\": \"<b>not bold</b>\"\n}")
headersHeader = InlineHeader("CardHeader and InlineHeader", "A card header with and without a subtitle, then inline headers with markdown.")
headers = Card([CardHeader("North field"), CardHeader("River bottom", "18 acres, soybeans"), InlineHeader("Plain heading"), InlineHeader("**Bold** heading", "With a *description* and a [link](https://example.com)")])
