$location = "north-field"
root = Card([title, fieldSelect, chart, days, sprayable, followUp])
title = TextContent("Seven-day forecast", "large-heavy")
locations = Query("listLocations", {}, {locations: []})
forecast = Query("getForecast", {location: $location, days: 7}, {days: []}, 30)
fieldSelect = FormControl("Field", Select("field", @Each(locations.locations, "l", SelectItem(l.id, l.name)), null, null, $location))
chart = LineChart(forecast.days.date, [Series("High °F", forecast.days.highF), Series("Low °F", forecast.days.lowF)])
days = @Count(forecast.days) == 0 ? TextContent("Loading the forecast…") : Table([Col("Day", forecast.days.date), Col("High °F", forecast.days.highF), Col("Low °F", forecast.days.lowF), Col("Rain %", forecast.days.rainChance), Col("Wind mph", forecast.days.windMph), Col("Spray", @Each(forecast.days, "d", d.sprayable ? Tag("yes", null, null, "success") : Tag("no", null, null, "neutral")))])
sprayable = TextContent("Days you can spray: " + @Count(@Filter(forecast.days, "sprayable", "==", true)) + " of 7", "small-heavy")
followUp = Buttons([Button("Plan a spray job", @ToAssistant("Plan a spray job for " + $location), "secondary")])
