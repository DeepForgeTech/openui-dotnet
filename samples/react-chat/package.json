{
  "name": "openui-dotnet-react-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "DO_NOT_TRACK=1 openui generate src/library.ts --spec --out src/generated/spec.json && DO_NOT_TRACK=1 openui generate src/library.ts --out src/generated/prompt.txt && rm src/generated/prompt.spec.json",
    "predev": "bun run generate",
    "dev": "vite",
    "prebuild": "bun run generate",
    "build": "vite build",
    "preview": "vite preview",
    "contract-check": "bun scripts/contract-check.ts",
    "browser-check": "bun scripts/browser-check.ts"
  },
  "dependencies": {
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.2",
    "@openuidev/react-ui": "0.18.1",
    "ai": "^7.0.85",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "rollup": "4.62.5",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
