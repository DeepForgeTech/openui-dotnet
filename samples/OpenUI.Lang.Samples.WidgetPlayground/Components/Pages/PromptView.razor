@page "/prompt"
@inject PlaygroundLibraries Libraries

<PageTitle>Prompt</PageTitle>

<div class="prompt-page">
    <div class="pane-head">
        <select @bind="_choice" aria-label="Library">
            <option value="widget">@Libraries.Widget.Title</option>
            <option value="page">@Libraries.Page.Title</option>
        </select>
        <span class="oui-muted">Generated by <code>SystemPrompt.Generate</code> from the same LibrarySpec the parser reads.</span>
    </div>
    <pre class="prompt">@Bundle.Prompt</pre>
    <details>
        <summary>Edit-mode prompt (what Refine sends, with the current program in the message)</summary>
        <pre class="prompt">@Bundle.EditPrompt</pre>
    </details>
    <details>
        <summary>LibrarySpec JSON</summary>
        <pre class="json">@Bundle.Spec.ToJson()</pre>
    </details>
</div>

@code {
    private string _choice = "widget";

    private LibraryBundle Bundle => _choice == "page" ? Libraries.Page : Libraries.Widget;
}
